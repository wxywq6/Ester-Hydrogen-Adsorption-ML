import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import shap
from sklearn.inspection import partial_dependence

# ==========================================================
# SHAP analysis
# ==========================================================

explainer = shap.TreeExplainer(model)
shap_values = explainer.shap_values(X_all)

shap_df = pd.DataFrame(shap_values, columns=selected_descriptors)

shap_df.to_csv(
    os.path.join(output_dir, "SHAP", "SHAP_values_all.csv"),
    index=False
)

# ==========================================================
# SHAP importance ranking
# ==========================================================

importance = pd.DataFrame({
    "Descriptor": selected_descriptors,
    "Mean_abs_SHAP": np.abs(shap_values).mean(axis=0)
})

importance = importance.sort_values(
    "Mean_abs_SHAP",
    ascending=False
)

importance.to_csv(
    os.path.join(output_dir, "SHAP", "SHAP_importance_rank_all.csv"),
    index=False
)

# ==========================================================
# Remove zero SHAP descriptors
# ==========================================================

active_descriptors = importance.loc[
    importance["Mean_abs_SHAP"] > 1e-8,
    "Descriptor"
].values


print(
    "Number of active SHAP descriptors:",
    len(active_descriptors)
)

print(
    active_descriptors
)


# Obtain corresponding SHAP values
active_index = [
    selected_descriptors.index(i)
    for i in active_descriptors
]


shap_values_active = (
    shap_values[:, active_index]
)


X_active = X_all[
    active_descriptors
]


# Save active SHAP values

shap_active_df = pd.DataFrame(
    shap_values_active,
    columns=active_descriptors
)


# ==========================================================
# SHAP summary plot (only non-zero descriptors)
# ==========================================================

plt.figure(
    figsize=(8,6)
)


shap.summary_plot(
    shap_values_active,
    X_active,
    show=False
)


ax = plt.gca()

# ==========================================================
# Descriptor correlation heatmap
# Pearson correlation
# ==========================================================

print("Generating descriptor correlation heatmap...")

# ============================
# Pearson correlation matrix
# ============================

corr_matrix = X_active.corr(
    method="pearson"
)


# ============================
# Plot heatmap
# ============================

plt.figure(
    figsize=(10,8),
    dpi=300
)

im = plt.imshow(
    corr_matrix,
    vmin=-1,
    vmax=1,
    aspect="equal"
)


# ============================
# Colorbar 设置
# ============================

cbar = plt.colorbar(im)

# 色条刻度字体
cbar.ax.tick_params(
    labelsize=16
)


for label in cbar.ax.get_yticklabels():

    label.set_fontname("Arial")
    label.set_fontsize(16)
    label.set_fontweight("bold")



# ============================
# Axis labels
# ============================

plt.xticks(
    range(len(active_descriptors)),
    active_descriptors,
    rotation=90,
    fontsize=16
)


plt.yticks(
    range(len(active_descriptors)),
    active_descriptors,
    fontsize=16
)

ax = plt.gca()


ax.set_xticks(
    np.arange(-0.5, len(active_descriptors), 1),
    minor=True
)


ax.set_yticks(
    np.arange(-0.5, len(active_descriptors), 1),
    minor=True
)


ax.grid(
    which="minor",
    color="white",
    linestyle="-",
    linewidth=1
)


ax.tick_params(
    which="minor",
    bottom=False,
    left=False
)

plt.close()

# ==========================================================
# SHAP-PDP dual-axis dependence plot
# Top12 descriptors
# Left axis: SHAP value
# Right axis: PDP response
# ==========================================================

print("Generating SHAP-PDP dual-axis plots...")



for feature in top12:


    print(
        "Generating SHAP-PDP:",
        feature
    )


    # ------------------------------------------------------
    # Feature index
    # ------------------------------------------------------

    feature_index = (
        active_descriptors.tolist()
        .index(feature)
    )


    # ------------------------------------------------------
    # SHAP values
    # ------------------------------------------------------

    feature_values = (
        X_active[feature].values
    )


    shap_feature_values = (
        shap_values_active[:, feature_index]
    )



    # ------------------------------------------------------
    # PDP calculation
    # ------------------------------------------------------

    pdp_result = partial_dependence(
        model,
        X_all,
        [feature],
        kind="average",
        grid_resolution=100
    )


    pdp_x = (
        pdp_result["grid_values"][0]
    )


    pdp_y = (
        pdp_result["average"][0]
    )
