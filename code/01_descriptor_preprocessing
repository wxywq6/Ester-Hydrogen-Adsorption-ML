import numpy as np

def preprocess_features(X, corr_threshold=0.95, var_threshold=0.01):

    X = X.copy()

    # ------------------------------------------------------
    # 1. Remove missing values (columns)
    # ------------------------------------------------------
    X = X.dropna(axis=1)

    # ------------------------------------------------------
    # 2. Remove zero-variance / constant features
    # ------------------------------------------------------
    X = X.loc[:, X.nunique() > 1]

    # ------------------------------------------------------
    # 3. Remove near-zero variance features
    # ------------------------------------------------------
    low_var_cols = [
        col for col in X.columns
        if X[col].var() < var_threshold
    ]
    X = X.drop(columns=low_var_cols)

    # ------------------------------------------------------
    # 4. Remove zero-heavy columns (optional but useful)
    # ------------------------------------------------------
    zero_ratio = (X == 0).sum() / len(X)
    X = X.loc[:, zero_ratio < 0.95]

    # ------------------------------------------------------
    # 5. Correlation filtering (remove redundant descriptors)
    # ------------------------------------------------------
    corr_matrix = X.corr().abs()
    upper = corr_matrix.where(
        np.triu(np.ones(corr_matrix.shape), k=1).astype(bool)
    )

    to_drop = [
        column for column in upper.columns
        if any(upper[column] > corr_threshold)
    ]

    X = X.drop(columns=to_drop)

    print("\n================ PRE-FILTER SUMMARY ================\n")
    print(f"Remaining descriptors after cleaning: {X.shape[1]}")
    print("===================================================\n")

    return X