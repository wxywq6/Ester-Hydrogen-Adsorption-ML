import numpy as np
import pandas as pd
from sklearn.utils import resample
from sklearn.linear_model import LassoCV
from sklearn.preprocessing import StandardScaler


# ==========================================================
# BOOTSTRAP STABILITY SELECTION
# ==========================================================
def stability_selection(X, y, n_bootstrap=100, threshold=0.4):

    feature_names = np.array(X.columns)
    selection_count = np.zeros(len(feature_names))

    for i in range(n_bootstrap):

        X_bs, y_bs = resample(X, y, random_state=i)

        scaler = StandardScaler()
        X_scaled = scaler.fit_transform(X_bs)
        
        alphas = np.logspace(-3, 0.5, 80)

        lasso = LassoCV(
            alphas=alphas,
            cv=5,
            max_iter=50000,
            tol=1e-3,
            random_state=42
            )

        lasso.fit(X_scaled, y_bs)

        selected = (np.abs(lasso.coef_) > 1e-6)
        selection_count += selected

    stability_score = selection_count / n_bootstrap

   
    stability_df = pd.DataFrame({

        "feature":
        feature_names,

        "stability_score":
        stability_score

    })


    stability_df = stability_df.sort_values(
        "stability_score",
        ascending=False
    )


    stable_features = (
        stability_df
        .loc[
            stability_df["stability_score"] >= threshold,
            "feature"
        ]
        .values
    )


    return (stable_features,stability_df)


