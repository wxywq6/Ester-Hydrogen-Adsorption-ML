from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from optuna.pruners import HyperbandPruner
import optuna
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import RBF, Matern, WhiteKernel, RationalQuadratic

def gpr_objective(trial):

    ls = trial.suggest_float("ls", 1, 50, log=True)
    noise = trial.suggest_float("noise", 0.1, 2.0)

    kernel_type = trial.suggest_categorical("kernel", ["Matern", "RBF", "RQ"])

    if kernel_type == "Matern":
        kernel = Matern(ls, nu=2.5)
    elif kernel_type == "RBF":
        kernel = RBF(ls)
    else:
        kernel = RationalQuadratic(ls)

    model = Pipeline([
        ("scaler", StandardScaler()),
        ("gpr", GaussianProcessRegressor(
            kernel=kernel + WhiteKernel(noise),
            alpha=1e-2,
            normalize_y=True
        ))
    ])

    return cv_score(model)


study_gpr = optuna.create_study(
    direction="maximize",    
    sampler=optuna.samplers.TPESampler(seed=42),
    pruner=HyperbandPruner()
)

study_gpr.optimize(gpr_objective, n_trials=80)

bp = study_gpr.best_params

if bp["kernel"] == "Matern":
    kernel = Matern(bp["ls"], nu=2.5)
elif bp["kernel"] == "RBF":
    kernel = RBF(bp["ls"])
else:
    kernel = RationalQuadratic(bp["ls"])

best_gpr = Pipeline([
    ("scaler", StandardScaler()),
    ("gpr", GaussianProcessRegressor(
        kernel=kernel + WhiteKernel(bp["noise"]),
        alpha=1e-2,
        normalize_y=True
    ))
])

best_gpr.fit(X_train, y_train)